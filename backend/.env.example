# ReplyRight backend environment. Copy to .env.local and fill in.
# Everything here stays on the server. The iOS app never contains an AI key.

# ---- AI provider -----------------------------------------------------------
# "anthropic" or "demo". If unset: Anthropic when ANTHROPIC_API_KEY is present,
# otherwise a clearly labelled demo mode that returns pre-written samples.
AI_PROVIDER=

# Anthropic API keys (https://platform.claude.com). Use two separate keys, and
# set a monthly spend limit on each in the Anthropic Console.
#
# ANTHROPIC_API_KEY is the PRODUCTION key. It is used only when the server runs
# as production (RR_ENVIRONMENT=production, or a production build without
# RR_ENVIRONMENT). Keep it off development machines.
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_DEV is the development and testing key. It is used by
# `npm run dev`, staging, `npm run eval` and anything else that is not
# production. A development server never falls back to ANTHROPIC_API_KEY: with
# no development key it runs in demo mode and says why in the log. A
# development key identical to the production key is refused.
ANTHROPIC_API_KEY_DEV=

# ---- Model routing (backend/src/lib/ai/router.ts, docs/COST-CONTROLS.md) ----
# Each kind of request has a route with its own model. Defaults: Haiku 5.5 for
# simple replies, starters, tweaks and tone rewrites; Sonnet 5.5 for reading,
# standard and screenshot replies, and coaching; Opus 5.5 for deep coaching.
# Change one route with AI_ROUTE_<ROUTE>="model[,effort=low|medium|high][,thinking=auto|off][,fallback=model|none]".
# Routes: READ_TEXT READ_SCREENSHOT REPLY_SIMPLE REPLY_STANDARD REPLY_SCREENSHOT
#         STARTER REFINE TONE COACH_ASK COACH_REVIEW COACH_PRACTICE COACH_ADVANCED
AI_ROUTE_REPLY_SIMPLE=
# Which replies count as simple (and use the REPLY_SIMPLE route).
# AI_SIMPLE_REPLIES=off sends every reply to REPLY_STANDARD.
AI_SIMPLE_REPLIES=
AI_SIMPLE_REPLY_INTENTS=
AI_SIMPLE_REPLY_MAX_CHARS=
# Rollback: "off" puts every route back on claude-opus-5-5 with adaptive
# thinking, exactly as before routing.
AI_ROUTING=

# One model for every route (leave empty to use the routing defaults). Setting
# it switches routing off in practice; AI_ROUTE_<ROUTE> still wins.
AI_MODEL=
# One model for every route of a task.
AI_MODEL_ANALYZE=
AI_MODEL_REPLIES=
AI_MODEL_REFINE=
AI_MODEL_COACH=

# Reasoning effort: low | medium | high. Defaults: analyze low, replies medium,
# refine low, coach medium. AI_EFFORT sets all; AI_EFFORT_<TASK> sets one.
AI_EFFORT=

# ---- AI cost control and usage records ---------------------------------------
# Development spend limit, in US dollars, estimated from the tokens each call
# reports. Applies to development, staging and eval runs, never to production.
# Before every AI attempt the server checks it; once reached, nothing more is
# sent until the period resets and requests fail with reason "budget".
# Default 5. "off" disables it.
RR_DEV_SPEND_LIMIT_USD=
# day | month (UTC). Default day.
RR_DEV_SPEND_PERIOD=
# Percentages that log a warning once per period. Default 50,75,90.
RR_DEV_SPEND_WARN_AT=
# Where the usage ledger is written (one JSON line per AI call: feature, model,
# tokens, estimated cost, status, timing, retries; never content). Default
# backend/.usage outside production, none in production. "off" disables the file.
# `npm run usage` summarises it.
RR_USAGE_LOG_DIR=
# Set to "off" to stop the one-line-per-AI-call usage record in the server log.
AI_USAGE_LOG=
# Extra attempts after a recoverable AI failure (overload, 5xx, 429, lost
# connection). Timeouts, refusals, unusable answers and other 4xx are never
# retried. Default 1, maximum 3.
AI_MAX_RETRIES=
# Exact repeats of a request still running (same install, same body) share one
# AI call. Set to "off" to disable.
RR_DEDUPE_REQUESTS=
# How long an AI call keeps running after the app that asked for it has gone,
# so a quick repeat can pick it up. Default 1000 ms. After that it is stopped.
RR_ABORT_GRACE_MS=

# ---- Deployment and diagnostics ---------------------------------------------
# development | staging | production. Shown in the app's connection screen so
# it is obvious which server a build is talking to. Default: production for a
# production build, development for `next dev`.
RR_ENVIRONMENT=
# Lets someone with this token run POST /api/v1/diagnostics/probe (one small
# real AI call) outside development. Leave empty to keep the probe closed in
# staging and production.
DIAGNOSTICS_TOKEN=
# Write the AI provider's own error text to the server log. On by default in
# development, off in production. It describes parameters, not conversations.
RR_DEBUG_ERRORS=
# One line per request (task, status, timing, request id; never content).
# Set to "off" to silence.
REQUEST_LOG=

# ---- Plans and limits ------------------------------------------------------
FREE_DAILY_GENERATIONS=10
FREE_DAILY_COACH_MESSAGES=3
PRO_DAILY_GENERATIONS=400
PRO_DAILY_COACH_MESSAGES=200
# Comma-separated intent ids available on the free plan.
# Default: natural,flirt,laugh,interest,keep_going,boundary
FREE_INTENTS=
# Set to "off" to disable daily limits (local development).
USAGE_LIMITS=
# Requests per minute per IP across the API. Default 30.
RATE_LIMIT_PER_MINUTE=

# ---- Subscriptions (StoreKit 2) --------------------------------------------
# The app's bundle identifier. Signed transactions for other apps are refused.
APPLE_BUNDLE_ID=com.replyright.app
# Product ids that grant Pro.
PRO_PRODUCT_IDS=com.replyright.pro.monthly,com.replyright.pro.annual
# Accept Sandbox transactions (TestFlight and App Review use them). Default true.
ENTITLEMENT_ALLOW_SANDBOX=true
# DEVELOPMENT ONLY. Accept purchases made with Xcode's local StoreKit testing,
# which are not signed by Apple. Never enable in production.
ENTITLEMENT_TRUST_XCODE=false

# ---- Site ------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
