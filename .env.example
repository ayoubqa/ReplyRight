# ReplyRight environment variables. Copy to .env.local and fill in.
# All values are read on the server only. Never prefix secrets with NEXT_PUBLIC_.

# Which AI provider to use: "anthropic" or "demo".
# Optional: if unset, ReplyRight uses Anthropic when ANTHROPIC_API_KEY is present,
# and otherwise runs in a clearly labelled demo mode with pre-written samples.
AI_PROVIDER=

# Anthropic API key (https://platform.claude.com). Required for real AI replies.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Optional reasoning effort: low | medium | high. Defaults to medium.
# Lower is faster and cheaper; higher can improve nuance.
AI_EFFORT=

# Optional per-IP request limit for /api/replies (per minute). Defaults to 20.
RATE_LIMIT_PER_MINUTE=
