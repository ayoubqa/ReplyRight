// Settings shared by the app, the keyboard extension and the share extension.
// Change the identifiers here, in one place, when you set up your own Apple Developer team.

// Reverse-DNS prefix for every bundle identifier:
//   app       $(RR_BUNDLE_ID_PREFIX).app
//   keyboard  $(RR_BUNDLE_ID_PREFIX).app.keyboard
//   share     $(RR_BUNDLE_ID_PREFIX).app.share
RR_BUNDLE_ID_PREFIX = com.replyright

// App Group shared by the three targets. Register it in your developer account.
RR_APP_GROUP = group.$(RR_BUNDLE_ID_PREFIX).shared

// Keychain group shared by the three targets (the team prefix is filled in at signing time).
RR_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(RR_BUNDLE_ID_PREFIX).shared

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Your Apple Developer Team ID. Leave empty to build for the simulator only.
DEVELOPMENT_TEAM =

// ---------------------------------------------------------------------------
// ReplyRight servers
//
// One address per environment. A build talks to the environment named in
// RR_API_ENVIRONMENT (set in Debug.xcconfig and Release.xcconfig). Debug
// builds can also switch between them in the app, under You > Connection.
//
// An address is written as a scheme and a host because "//" starts a comment
// in this file. The host may include a port. No AI key ever goes here: keys
// live only on the server.
//
// Development: the server on your Mac (`npm run dev` in backend/).
//   The simulator can use localhost. A real iPhone cannot: use your Mac's
//   network name instead, for example  my-mac.local:3000
RR_API_DEV_SCHEME = http
RR_API_DEV_HOST = localhost:3000

// Staging: a deployed copy for testing. Leave the host empty until you have one.
RR_API_STAGING_SCHEME = https
RR_API_STAGING_HOST =

// Production: the server real users talk to. Replace with your own domain.
RR_API_PROD_SCHEME = https
RR_API_PROD_HOST = api.replyright.app
